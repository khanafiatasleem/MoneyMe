# ==============================================================================
# MoneyMe Environment Configuration Example
# ==============================================================================
# Copy this file to .env or set environment variables in your deployment host.
# NEVER commit actual secrets, database passwords, or JWT keys to source control.

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/moneyme_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password_here

# JWT Authentication Secret (Minimum 256 bits / 32 characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Server Port
PORT=8080

# Frontend API URL (for production React build)
VITE_API_URL=https://moneyme-backend-api.onrender.com/api

